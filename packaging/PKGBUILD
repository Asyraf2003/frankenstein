pkgbase=frankenstein
pkgname=('frankenstein-core' 'frankenstein-openbox')
pkgver=0.2.0
pkgrel=1
pkgdesc='Arch-native foundation with explicit user profiles and file rollback'
arch=('any')
url='https://github.com/Asyraf2003/frankenstein'
license=('AGPL-3.0-only' 'MIT')
options=('!debug')
source=()
sha256sums=()

check() {
    PYTHONDONTWRITEBYTECODE=1 python -m unittest discover -s "$startdir/../tests" -p 'test_*.py'
}

package_frankenstein-core() {
    depends=('bash' 'python' 'pacman' 'systemd' 'util-linux' 'coreutils' 'grep')
    optdepends=('sudo: privileged package and radio actions'
                'github-cli: verify and stage selected stable engine releases'
                'age: native encrypted portable vault envelopes'
                'android-tools: authenticated USB transport to the companion'
                'openssl: per-device USB TLS identity generation'
                'git: keep decrypted recovery output outside Git worktrees'
                'zoxide: optional interactive shell directory navigation'
                'fzf: optional interactive shell completion and key bindings'
                'polkit: native authorization for unprivileged power and network actions'
                'networkmanager: Wi-Fi controls'
                'bluez: native Bluetooth service'
                'bluez-utils: Bluetooth controls')
    cd "$startdir/.."
    install -Dm755 bin/frankenstein "$pkgdir/usr/bin/frankenstein"
    install -Dm644 lib/control.py "$pkgdir/usr/lib/frankenstein/control.py"
    install -Dm644 lib/profiles.py "$pkgdir/usr/lib/frankenstein/profiles.py"
    install -Dm644 lib/releases.py "$pkgdir/usr/lib/frankenstein/releases.py"
    install -Dm644 lib/engine_update.py "$pkgdir/usr/lib/frankenstein/engine_update.py"
    install -Dm644 lib/provision.py "$pkgdir/usr/lib/frankenstein/provision.py"
    install -Dm644 lib/device_sync.py "$pkgdir/usr/lib/frankenstein/device_sync.py"
    install -Dm644 assets/frankenstein-sync.service "$pkgdir/usr/lib/systemd/user/frankenstein-sync.service"
    install -Dm644 vault/recovery_kit.py "$pkgdir/usr/lib/frankenstein/vault/recovery_kit.py"
    install -Dm644 vault/recovery_opening.py "$pkgdir/usr/lib/frankenstein/vault/recovery_opening.py"
    install -Dm644 vault/recovery_backup.py "$pkgdir/usr/lib/frankenstein/vault/recovery_backup.py"
    install -Dm644 vault/backup.py "$pkgdir/usr/lib/frankenstein/vault/backup.py"
    install -Dm644 vault/portable.py "$pkgdir/usr/lib/frankenstein/vault/portable.py"
    install -Dm644 transport/usb.py "$pkgdir/usr/lib/frankenstein/transport/usb.py"
    install -Dm644 lib/first_boot.py "$pkgdir/usr/lib/frankenstein/first_boot.py"
    install -Dm644 assets/frankenstein-first-boot.service "$pkgdir/usr/lib/systemd/system/frankenstein-first-boot.service"
    for asset in profiles/shell/*; do
        install -Dm644 "$asset" "$pkgdir/usr/share/frankenstein/$asset"
    done
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 licenses/upstream-MIT "$pkgdir/usr/share/licenses/$pkgname/upstream-MIT"
}

package_frankenstein-openbox() {
    pkgdesc='Optional reusable Openbox/X11 desktop profile for Frankenstein'
    depends=('frankenstein-core' 'openbox' 'xorg-server' 'xorg-xinit'
             'xorg-xsetroot' 'dbus' 'python-pyxdg' 'xterm' 'thunar' 'rofi'
             'dunst' 'ttf-dejavu' 'playerctl' 'pipewire' 'pipewire-pulse' 'wireplumber')
    cd "$startdir/.."
    for command in frankenstein-openbox vol mic; do
        install -Dm755 "bin/$command" "$pkgdir/usr/bin/$command"
    done
    install -Dm755 bin/frankenstein-welcome "$pkgdir/usr/bin/frankenstein-welcome"
    install -Dm644 lib/welcome.py "$pkgdir/usr/lib/frankenstein/welcome.py"
    for asset in profiles/openbox/*; do
        install -Dm644 "$asset" "$pkgdir/usr/share/frankenstein/$asset"
    done
    chmod 755 "$pkgdir/usr/share/frankenstein/profiles/openbox/"{xinitrc,autostart}
    install -Dm644 assets/frankenstein-openbox.desktop "$pkgdir/usr/share/xsessions/frankenstein-openbox.desktop"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 licenses/upstream-MIT "$pkgdir/usr/share/licenses/$pkgname/upstream-MIT"
}

#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo 'Usage: vol [0..100 | mute | unmute | status]'
}

(( $# <= 1 )) || { usage >&2; exit 2; }
action=${1-status}
node=@DEFAULT_AUDIO_SINK@

case "$action" in
    status) args=(get-volume "$node") ;;
    mute) args=(set-mute "$node" 1) ;;
    unmute) args=(set-mute "$node" 0) ;;
    -h|--help) usage; exit 0 ;;
    *)
        # Bound the digit count before arithmetic; interpret leading zeros as decimal.
        [[ $action =~ ^[0-9]{1,3}$ ]] || { usage >&2; exit 2; }
        percent=$((10#$action))
        (( percent <= 100 )) || { usage >&2; exit 2; }
        args=(set-volume -l 1.0 "$node" "$percent%")
        ;;
esac

command -v wpctl >/dev/null 2>&1 || {
    echo 'ERROR: vol requires wpctl (WirePlumber).' >&2
    exit 127
}
exec wpctl "${args[@]}"
